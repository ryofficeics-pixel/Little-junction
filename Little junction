<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0e2028">
<title>Little Junction — Tabletop Railway</title>
<style>
:root{color-scheme:dark;--bg:#0e2028;--panel:#162c35;--line:#2b424a;--ink:#ecede3;--muted:#93a8ae;--yellow:#ffc66b;--green:#8ac9ab}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input{font:inherit}
button{cursor:pointer;touch-action:manipulation;border:1px solid var(--line);border-radius:9px;background:#203943;color:var(--ink);padding:10px 13px;min-height:42px}
button:hover{background:#2b4851}
button:focus-visible,input:focus-visible,canvas:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}
button[aria-pressed=true]{background:var(--yellow);color:#183039;border-color:var(--yellow)}
header{height:86px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;border-bottom:1px solid var(--line);gap:15px}
.brand{display:flex;gap:13px;align-items:center}
.badge{height:43px;width:43px;display:grid;place-items:center;border-radius:11px;background:var(--yellow);color:#16303b}
.brand h1{font-size:22px;letter-spacing:-.7px;margin:0;line-height:1.1}
.brand small{font-size:9px;letter-spacing:2.2px;color:var(--muted)}
.headbuttons{display:flex;gap:8px}
.headbuttons button{font-size:12px}
.live{font-size:10px;letter-spacing:1.3px;color:var(--green);margin-right:12px}
.dot{display:inline-block;width:6px;height:6px;background:var(--green);border-radius:50%;margin-right:7px;box-shadow:0 0 9px #8ac9ab60}
main{display:grid;grid-template-columns:minmax(0,1fr) 286px;min-height:calc(100svh - 86px)}
.world{position:relative;overflow:hidden;min-height:590px;background:#e7dcc6;isolation:isolate}
canvas{display:block;width:100%;height:100%;position:absolute;inset:0;touch-action:none;cursor:grab}
canvas:active{cursor:grabbing}
.scene-title{position:absolute;top:24px;left:26px;pointer-events:none;color:#344e47}
.eyebrow{font:10px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:1.9px}
.scene-title h2{font-family:Georgia,serif;font-size:31px;font-weight:normal;margin:8px 0 5px;letter-spacing:-.7px}
.scene-title p{font-size:11px;margin:0;opacity:.75}
.scene-title.night{color:#dbe7df}
.view{position:absolute;right:17px;top:20px;display:flex;gap:5px}
.view button{background:#f4ead6d9;border:1px solid #6d7b6340;color:#304f45;padding:7px 12px;box-shadow:0 2px 5px #11252a0a}
.view button:hover{background:#fff4df}
.scene-footer{position:absolute;bottom:17px;left:20px;right:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;pointer-events:none}
.legend{color:#38594b;font-size:10px;letter-spacing:.4px;background:#f8efdacc;border:1px solid #62846833;padding:8px 11px;border-radius:7px}
.legend b{color:#967345}
.worldstatus{display:flex;align-items:center;gap:7px;color:#244c42;background:#f8efdbe6;border-radius:20px;padding:8px 12px;font:10px ui-monospace,monospace}
.worldstatus i{height:6px;width:6px;background:#487f60;border-radius:50%}
.toast{position:absolute;left:50%;bottom:65px;transform:translate(-50%,12px);background:#102c30ed;color:#fff0d6;padding:12px 18px;border-radius:9px;max-width:90%;font-size:12px;line-height:1.5;text-align:center;opacity:0;transition:.2s;pointer-events:none;box-shadow:0 7px 22px #0e202830}
.toast.show{opacity:1;transform:translate(-50%,0)}
aside{padding:22px 20px 18px;border-left:1px solid var(--line);display:flex;flex-direction:column;gap:20px}
aside h2{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:var(--muted);margin:0 0 13px}
.row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.trainname{font-weight:650;font-size:14px}
.trainname span{color:var(--yellow);margin-right:6px}
.tag{font:9px ui-monospace,monospace;padding:5px 7px;border:1px solid var(--line);border-radius:4px;color:var(--green)}
.speedbox{display:flex;align-items:baseline;gap:7px;margin-top:13px}
.speedbox strong{font:38px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:-2px}
.speedbox small{color:var(--muted);font-size:10px}
.speedbox .mini{margin-left:auto;color:var(--muted);font:10px ui-monospace,monospace}
label{display:block;color:var(--muted);font-size:11px;margin:12px 0 6px}
input[type=range]{width:100%;accent-color:var(--yellow);cursor:pointer;height:22px;margin:0}
.twobuttons{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}
.twobuttons button{font-size:12px}
.primary{background:var(--yellow);color:#123138;border-color:var(--yellow);font-weight:650}
.primary:hover{background:#ffda92}
.separator{height:1px;background:var(--line)}
.switches{display:flex;gap:6px}
.switches button{flex:1;font-size:11px;padding:8px}
.hint{font-size:10px;line-height:1.6;color:var(--muted);margin:8px 0 0;min-height:32px}
.yard{margin-top:13px}
.order{margin-top:12px;padding:12px;border:1px solid #59796055;background:#8ac9ab0b;border-radius:9px}
.order small{color:var(--green);font-size:9px;letter-spacing:1.5px}
.order p{font-size:12px;margin:6px 0 0;line-height:1.5}
.full{width:100%;margin-top:10px;font-size:12px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-top:auto}
.stats div{text-align:center;border-top:1px solid var(--line);padding-top:12px}
.stats b{display:block;font:21px ui-monospace,monospace;color:var(--yellow)}
.stats small{font-size:8px;letter-spacing:1px;color:var(--muted)}
.footnote{font-size:9px;color:#708d96;text-align:center;line-height:1.7}
dialog{max-width:440px;width:calc(100% - 30px);background:var(--panel);color:var(--ink);border:1px solid #5d7d86;border-radius:16px;padding:25px;box-shadow:0 25px 100px #0008}
dialog::backdrop{background:#06181bbb}
dialog h2{margin-top:0}
dialog p{line-height:1.7;color:#c2d2d0;font-size:13px}
kbd{border:1px solid #58727a;padding:2px 5px;border-radius:4px;font-size:11px}
.helpclose{float:right;min-height:32px;padding:4px 10px}
noscript{display:block;padding:25px}
@media(min-width:1500px){
 main{grid-template-columns:minmax(0,1fr) 310px}
 aside{padding:30px 26px}
 .world{min-height:740px}
}
@media(max-width:850px){
 header{height:73px;padding:0 16px}
 .brand h1{font-size:18px}
 .brand small{font-size:8px;letter-spacing:1.4px}
 .live{display:none}
 .headbuttons{gap:5px}
 .headbuttons button{padding:8px 10px}
 .world{min-height:500px}
 main{grid-template-columns:minmax(0,1fr) 248px}
 aside{padding:20px 14px;gap:16px}
 .scene-title{left:18px;top:20px}
 .scene-title h2{font-size:25px}
 .view{top:98px;right:12px;flex-direction:column}
 .legend{display:none}
}
@media(max-width:650px){
 header{height:73px}
 .badge{width:33px;height:36px;border-radius:8px}
 .brand{gap:8px}
 .brand h1{font-size:17px}
 .headbuttons button{font-size:11px;padding:7px 9px}
 main{display:flex;flex-direction:column}
 .world{min-height:420px;height:53svh;max-height:620px}
 .scene-title h2{font-size:26px}
 .scene-title p{font-size:10px;max-width:220px}
 .scene-title .eyebrow{font-size:9px}
 .view{top:19px;flex-direction:row}
 .view button{padding:6px 9px;min-height:34px}
 .scene-footer{bottom:12px;left:13px;right:13px}
 .legend{display:block;font-size:9px;padding:7px}
 .worldstatus{font-size:9px;padding:8px}
 .toast{bottom:52px;width:max-content}
 aside{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:20px 16px;border-left:0;border-top:1px solid var(--line)}
 .separator{display:none}
 .stats,.footnote{grid-column:1/-1}
 .speedbox strong{font-size:33px}
 .trainname{font-size:12px}
 .tag{font-size:8px}
 .hint{min-height:46px}
 .order{padding:10px}
}
@media(max-width:380px){
 header{padding:0 10px;gap:8px}
 .brand small{font-size:7px;letter-spacing:.8px}
 .brand h1{font-size:15px}
 .badge{width:28px}
 .headbuttons button{padding:7px 8px}
}
@media(prefers-reduced-motion:reduce){.toast{transition:none}}
</style>
</head>
<body>
<header>
 <div class="brand">
  <div class="badge" aria-hidden="true">
   <svg width="27" height="29" viewBox="0 0 30 30" fill="none">
    <path d="M7 19V6q0-3 3-3h10q3 0 3 3v13q0 4-4 4h-8q-4 0-4-4Z" stroke="currentColor" stroke-width="2"/>
    <path d="M10 7h10v6H10z" fill="currentColor"/>
    <circle cx="11" cy="18" r="1.5" fill="currentColor"/>
    <circle cx="19" cy="18" r="1.5" fill="currentColor"/>
    <path d="m10 23-4 5m14-5 4 5M8 26h14" stroke="currentColor" stroke-width="2"/>
   </svg>
  </div>
  <div><h1>Little Junction</h1><small>SMALL TRAINS. BIG DAY.</small></div>
 </div>
 <div class="headbuttons">
