 </aside>
</main>

<dialog id="instructions">
 <button class="helpclose" id="closeHelp" aria-label="Close instructions">×</button>
 <h2>Your very small railway.</h2>
 <p>Drag the table to orbit. Scroll or pinch to zoom. Tap <b>⌂</b> to return to the best view.</p>
 <p>The express accelerates gently, slows into curves and stops at the platform. Choose <b>Bypass</b> to skip the station. Route changes wait until the entire train is safely clear.</p>
 <p>Your shunter loads at a siding, backs into the headshunt and goes out again. Choose <b>01, 02 or 03</b> to complete the next little job. New points apply when the train clears the junction.</p>
 <p>Crossing gates and road traffic work automatically. Try night mode, blow the whistle, or click a tree for a tiny surprise.</p>
 <p><kbd>Space</kbd> pause · <kbd>H</kbd> whistle · <kbd>N</kbd> night · <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> sidings</p>
 <button id="save" class="primary full">Download this HTML</button>
</dialog>
<noscript>This railway needs JavaScript enabled in your browser.</noscript>

<script>
'use strict';

const $=id=>document.getElementById(id);
const canvas=$('scene'),ctx=canvas.getContext('2d');
const TAU=Math.PI*2;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const mix=(a,b,t)=>a+(b-a)*t;

let seed=487;
function random(){
 seed=(seed*1664525+1013904223)>>>0;
 return seed/4294967296;
}

/* Arc-length tracks keep each wagon on the rails. */
class Track{
 constructor(closed=false){
  this.p=[];
  this.L=0;
  this.closed=closed;
 }
 add(x,z){
  const last=this.p[this.p.length-1];
  if(last)this.L+=Math.hypot(x-last.x,z-last.z);
  this.p.push({x,z,s:this.L});
  return this;
 }
 line(x,z){return this.add(x,z)}
 curve(cx,cz,dx,dz,x,z){
  const a=this.p[this.p.length-1];
  for(let i=1;i<=50;i++){
   const t=i/50,u=1-t;
   this.add(
    u*u*u*a.x+3*u*u*t*cx+3*u*t*t*dx+t*t*t*x,
    u*u*u*a.z+3*u*u*t*cz+3*u*t*t*dz+t*t*t*z
   );
  }
  return this;
 }
 arc(cx,cz,r,a,b){
  for(let i=1;i<=100;i++){
   const t=mix(a,b,i/100);
   this.add(cx+Math.cos(t)*r,cz+Math.sin(t)*r);
  }
  return this;
 }
 point(s){
  s=this.closed?((s%this.L)+this.L)%this.L:clamp(s,0,this.L);
  let l=0,r=this.p.length-1;
  while(l+1<r){
   const m=(l+r)>>1;
   if(this.p[m].s<s)l=m;
   else r=m;
  }
  const a=this.p[l],b=this.p[r],t=(s-a.s)/(b.s-a.s||1);
  return{x:mix(a.x,b.x,t),z:mix(a.z,b.z,t)};
 }
 pose(s){
  const p=this.point(s),a=this.point(s-.38),b=this.point(s+.38);
  return{...p,a:Math.atan2(b.z-a.z,b.x-a.x)};
 }
 nearest(x,z){
  let best=Infinity,s=0;
  for(let d=0;d<this.L;d+=.06){
   const p=this.point(d),v=Math.hypot(x-p.x,z-p.z);
   if(v<best){best=v;s=d}
  }
  return s;
 }
}

function mainTrack(platform){
 const t=new Track(true)
  .add(-10,-7).line(10,-7)
  .arc(10,0,7,-Math.PI/2,Math.PI/2);
 if(!platform){
  t.line(7,7).curve(5,7,5,9,3,9)
   .line(-3,9).curve(-5,9,-5,7,-7,7);
 }
 t.line(-10,7).arc(-10,0,7,Math.PI/2,3*Math.PI/2);
 return t;
}

const mainTracks=[mainTrack(true),mainTrack(false)];
const sidings=[-3.5,-.4,2.7];
const yardTracks=sidings.map(z=>
 new Track().add(-11,-3.5).line(-4,-3.5)
 .curve(-1.5,-3.5,-1.5,z,1.5,z).line(10.8,z)
);
const crossingPositions=mainTracks.map(p=>
 [-6.325,6.325].map(z=>p.nearest(-13,z))
);
const stopPosition=mainTracks[0].nearest(-2,7);

const mainTrain={
 s:12,v:2.2,route:0,next:0,dwell:0,served:false,laps:0
};
const freight={
 s:9,v:1.3,route:0,next:0,dir:1,dwell:0,loads:0,jobs:0,job:1
};

let paused=matchMedia('(prefers-reduced-motion: reduce)').matches;
let night=false,nightMix=0,power=.65,time=0;
let gate=0,gateDown=false,particles=[],steam=0,toastTime=0;

const cars=[
 {z:-11,dir:1,x:-13.57,color:'#eac369',v:0},
 {z:3,dir:-1,x:-12.43,color:'#7daca5',v:1.3}
];

let audioContext=null,rumble=null,rumbleGain=null,soundOn=false;

function toast(msg){
 $('toast').textContent=msg;
 $('toast').classList.add('show');
 toastTime=4;
}

function note(freq,duration=.2,volume=.045,type='sine',delay=0){
 if(!soundOn||!audioContext)return;
 const o=audioContext.createOscillator();
 const g=audioContext.createGain();
 const t=audioContext.currentTime+delay;
 o.type=type;
 o.frequency.setValueAtTime(freq,t);
 g.gain.setValueAtTime(0,t);
 g.gain.linearRampToValueAtTime(volume,t+.025);
 g.gain.exponentialRampToValueAtTime(.001,t+duration);
 o.connect(g);
 g.connect(audioContext.destination);
 o.start(t);
 o.stop(t+duration+.03);
}

function whistle(){
 const p=mainTracks[mainTrain.route].pose(mainTrain.s);
 for(let i=0;i<10;i++)puff(p.x,p.z,2,0);
 if(soundOn){
  note(440,.9,.06,'triangle');
  note(554,.85,.035,'triangle');
  note(660,.8,.025,'sine');
 }
 toast(soundOn?'All aboard!':'Toot toot! Enable Sound to hear the whistle.');
}

function puff(x,z,y,kind){
 particles.push({
  x,z,y,
  vx:(random()-.5)*.35,
  vz:(random()-.5)*.3,
  vy:kind===1?2+random()*3:.65+random()*.5,
  life:kind===1?2:3,
  max:kind===1?2:3,
  size:kind===1?.13:.28+random()*.2,
  kind,
  color:['#ffc66b','#db7864','#9dcabb','#e6e9c9'][Math.floor(random()*4)]
 });
}

function setRoute(n){
 mainTrain.next=n;
 sync();
 toast('Express route requested: '+(n===0?'platform.':'bypass.'));
}
function setSiding(n){
 freight.next=n;
 sync();
 toast('Siding 0'+(n+1)+' queued. Points move when the train is clear.');
}

/* Independent main line and yard circuits prevent train conflicts. */
function update(dt){
 if(!paused){
  time+=dt;
  const m=mainTrain;

  // Both main routes share this clear stretch of straight track.
  if(m.route!==m.next&&m.s>9&&m.s<18.8){
   m.route=m.next;
   toast('Main line points set. '+(m.route?'Bypass clear.':'Platform clear.'));
  }

  const path=mainTracks[m.route],pos=path.point(m.s);
  let target=power*5.3;
  if(Math.abs(pos.x)>10)target=Math.min(target,2.15);

  let stopDist=Infinity;
  if(m.route===0&&!m.served&&m.s<=stopPosition){
   stopDist=stopPosition-m.s;
  }

  if(m.dwell>0){
   m.dwell=Math.max(0,m.dwell-dt);
   target=0;
   if(m.dwell<=0){
    m.served=true;
    toast('Doors closed. Next stop: another lap.');
    note(650,.2,.035);
    note(870,.25,.035,'sine',.2);
   }
  }else if(stopDist<8){
   target=Math.min(target,Math.sqrt(2*1.3*Math.max(0,stopDist)));
  }

  m.v+=clamp(target-m.v,-1.4*dt,.75*dt);
  let ds=m.v*dt;

  if(!m.served&&!m.dwell&&stopDist<.05&&power>0){
   m.s=stopPosition;
   m.v=0;
   m.dwell=4.2;
   ds=0;
   toast('Juniper Express: passengers boarding.');
  }else if(ds>stopDist){
   ds=stopDist;
   m.v=0;
  }

  m.s+=ds;
  if(m.s>=path.L){
   m.s-=path.L;
   m.laps++;
   m.served=false;
  }

  const f=freight;
  const wasDwelling=f.dwell>0;
  const fp=yardTracks[f.route];
  const end=f.dir>0?fp.L-1.25:5.5;
  const remain=Math.abs(end-f.s);
  const fv=f.dwell>0?0:Math.min(2.2,Math.sqrt(2*1.4*remain));

  if(f.dwell>0){
   f.dwell-=dt;
   if(f.dwell<=0)f.dir*=-1;
  }

  f.v+=clamp(fv-f.v,-1.5*dt,1.0*dt);

  if(!wasDwelling){
   const step=Math.min(remain,f.v*dt);
   f.s+=step*f.dir;

   if(remain<.035){
    f.s=end;
    f.v=0;
    f.dwell=f.dir>0?3.5:1.8;

    if(f.dir>0){
     f.loads++;
     if(f.route===f.job){
      f.jobs++;
      f.job=(f.job+1+(random()>.5?1:0))%3;
      for(let i=0;i<25;i++)puff(9,sidings[f.route],1.7,1);
      toast('Job complete! One tiny delivery, one big win.');
      [520,650,780,1040].forEach((hz,i)=>
       note(hz,.2,.035,'sine',i*.11)
      );
     }
    }else{
     // The complete consist is behind the junction.
     f.route=f.next;
     toast('Yard points set to siding 0'+(f.route+1)+'.');
    }
   }
  }

  const cps=crossingPositions[m.route];
  gateDown=cps.some(s=>
   ((s-m.s+path.L)%path.L)<Math.max(5.5,m.v*2.6+1.5)||
   ((m.s-s+path.L)%path.L)<8.8
  );
  gate+=clamp((gateDown?1:0)-gate,-dt*.8,dt*.9);

  if(gateDown&&Math.floor(time*2)!==Math.floor((time-dt)*2)){
   note(940,.09,.015);
  }

  for(const car of cars){
   let blocked=false;
   if(gateDown||gate>.05){
    for(const z of [-6.325,6.325]){
     const stop=z-car.dir*2.0;
     const gap=(stop-car.z)*car.dir;
     if(gap>=-.02&&gap<2.6){
      blocked=true;
      car.v=Math.min(car.v,Math.sqrt(2*2.5*Math.max(0,gap)));
      if(gap<.035){
       car.z=stop;
       car.v=0;
      }
     }
